# Yalnızca sunucu ortamı; NEXT_PUBLIC_ öneki kullanmayın.
LUMI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# İsteğe bağlı alternatif: LUMI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Üretimde zorunlu: en az 12 karakter.
LUMI_ACCESS_PASSWORD=
# Üretimde zorunlu: en az 32 karakterlik rastgele sır.
LUMI_SESSION_SECRET=
# Üretimde HTTPS origin; sonunda / olmadan.
LUMI_APP_ORIGIN=
# Yerelde boş; bulutta kalıcı diskte /data/lumi
LUMI_DATA_DIR=

# Doğum günü atölyesi: alıcı parolasından ayrı, en az 12 karakter.
BIRTHDAY_CREATOR_PASSWORD=
# Üretimde zorunlu; en az 32 karakter. Boşsa mevcut LUMI_SESSION_SECRET kullanılabilir.
BIRTHDAY_SESSION_SECRET=
# İsteğe bağlı alıcı parolası. Boşsa LUMI_ACCESS_PASSWORD kullanılır.
BIRTHDAY_ACCESS_PASSWORD=
# Boşsa LUMI_APP_ORIGIN kullanılır. Üretimde gerçek HTTPS adresi gerekir.
BIRTHDAY_APP_ORIGIN=
# Yerelde boş; bulutta /data/birthday için aynı kalıcı diski kullanın.
BIRTHDAY_DATA_DIR=

# Hesaplar ve bulut eşitlemesi. Yalnızca gerçek Supabase projenizin değerleri.
# URL ve publishable/anon anahtarı /api/account/config ile tarayıcıya verilir;
# özel veriyi RLS korur. Secret/service_role anahtarını bu alana YAZMAYIN.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# İsteğe bağlı, yalnızca sunucuda: yeniden parola doğrulamalı hesap silme.
# NEXT_PUBLIC_ öneki kesinlikle kullanılmaz.
SUPABASE_SERVICE_ROLE_KEY=

# Ters proxy arkasında hesap silme isteğinin beklenen HTTPS origin adresi.
# Boşsa LUMI_APP_ORIGIN veya isteğin origin adresi kullanılır.
ACCOUNT_APP_ORIGIN=

# 16. adım: üretim için docs/DEPLOYMENT.md sırasını izleyin.
# Eski yerel depo kalıcı disk ister; Render Free için docs/STATELESS-HOSTING.md.
# PWA için ek anahtar gerekmez; HTTPS üzerinden çalışır.

# Durumsuz Render Free hazırlığı: yerelde eski depoyu korur.
# Üretimde açıkça supabase seçilmeli ve 008/009 + onaylı aktarım doğrulanmalı.
SERVER_STORAGE=local
# Yalnızca eski kalıcı disk kurulumunda açık onay: true. Render Free için boş bırakın.
SERVER_LOCAL_DISK_CONFIRMED=
# Yalnızca sunucu: Supabase secret key (sb_secret_...) veya legacy service_role.
# Publishable/anon anahtarı OLMAZ. NEXT_PUBLIC_ kullanmayın.
SUPABASE_SERVER_SECRET_KEY=

# İsteğe bağlı web push. npm run push:keys özel anahtarları .cache içine yazar.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=
# Sunucu zamanlayıcısı için en az 32 karakter rastgele sır.
REMINDER_CRON_SECRET=
